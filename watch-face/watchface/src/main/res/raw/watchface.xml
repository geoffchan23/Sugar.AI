<?xml version="1.0" encoding="utf-8"?>
<!--
  Big Glucose watch face.

  Layout mirrors the stock Pixel digital face:
      MON AUG 31      <- date, small ("MON" periwinkle, "AUG 31" white)
        10:50         <- time, large periwinkle
        9.9           <- glucose complication, LARGE white (this is the point)

  The canvas below is 450x450. Wear OS scales it to the real screen
  (the Pixel Watch 2 is 384x384), so all coordinates are resolution
  independent - do not change them to match your watch.

  Colors were sampled from an ADB screenshot of the real stock face
  (not the photo): weekday #aeb4ff, clock #a0a7ff, date suffix and
  glucose both #ffffff.

  The date is built from Condition lookup tables because WFF has no
  uppercase function: [DAY_OF_WEEK_S] renders "Mon", the stock face
  shows "MON". [DAY_OF_WEEK] maps 1=Sunday .. 7=Saturday.

  The weekday is right-aligned to x=196 and the "AUG 31" part is
  left-aligned from x=211, so the pair reads as one centered line.
-->
<WatchFace width="450" height="450" clipShape="CIRCLE">

    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="10:50:00" />

    <Scene backgroundColor="#ff000000">

        <!-- ============================================================
             DATE - weekday, e.g. "MON", periwinkle
             ============================================================ -->
        <Condition>
            <Expressions>
                <Expression name="sun"><![CDATA[[DAY_OF_WEEK] == 1]]></Expression>
                <Expression name="mon"><![CDATA[[DAY_OF_WEEK] == 2]]></Expression>
                <Expression name="tue"><![CDATA[[DAY_OF_WEEK] == 3]]></Expression>
                <Expression name="wed"><![CDATA[[DAY_OF_WEEK] == 4]]></Expression>
                <Expression name="thu"><![CDATA[[DAY_OF_WEEK] == 5]]></Expression>
                <Expression name="fri"><![CDATA[[DAY_OF_WEEK] == 6]]></Expression>
            </Expressions>
            <Compare expression="sun">
                <PartText x="0" y="41" width="196" height="40">
                    <Text align="END"><Font family="SYNC_TO_DEVICE" size="30" weight="BOLD" color="#ffaeb4ff">SUN</Font></Text>
                </PartText>
            </Compare>
            <Compare expression="mon">
                <PartText x="0" y="41" width="196" height="40">
                    <Text align="END"><Font family="SYNC_TO_DEVICE" size="30" weight="BOLD" color="#ffaeb4ff">MON</Font></Text>
                </PartText>
            </Compare>
            <Compare expression="tue">
                <PartText x="0" y="41" width="196" height="40">
                    <Text align="END"><Font family="SYNC_TO_DEVICE" size="30" weight="BOLD" color="#ffaeb4ff">TUE</Font></Text>
                </PartText>
            </Compare>
            <Compare expression="wed">
                <PartText x="0" y="41" width="196" height="40">
                    <Text align="END"><Font family="SYNC_TO_DEVICE" size="30" weight="BOLD" color="#ffaeb4ff">WED</Font></Text>
                </PartText>
            </Compare>
            <Compare expression="thu">
                <PartText x="0" y="41" width="196" height="40">
                    <Text align="END"><Font family="SYNC_TO_DEVICE" size="30" weight="BOLD" color="#ffaeb4ff">THU</Font></Text>
                </PartText>
            </Compare>
            <Compare expression="fri">
                <PartText x="0" y="41" width="196" height="40">
                    <Text align="END"><Font family="SYNC_TO_DEVICE" size="30" weight="BOLD" color="#ffaeb4ff">FRI</Font></Text>
                </PartText>
            </Compare>
            <Default>
                <PartText x="0" y="41" width="196" height="40">
                    <Text align="END"><Font family="SYNC_TO_DEVICE" size="30" weight="BOLD" color="#ffaeb4ff">SAT</Font></Text>
                </PartText>
            </Default>
        </Condition>

        <!-- ============================================================
             DATE - month and day, e.g. "AUG 31", white
             ============================================================ -->
        <Condition>
            <Expressions>
                <Expression name="jan"><![CDATA[[MONTH] == 1]]></Expression>
                <Expression name="feb"><![CDATA[[MONTH] == 2]]></Expression>
                <Expression name="mar"><![CDATA[[MONTH] == 3]]></Expression>
                <Expression name="apr"><![CDATA[[MONTH] == 4]]></Expression>
                <Expression name="may"><![CDATA[[MONTH] == 5]]></Expression>
                <Expression name="jun"><![CDATA[[MONTH] == 6]]></Expression>
                <Expression name="jul"><![CDATA[[MONTH] == 7]]></Expression>
                <Expression name="aug"><![CDATA[[MONTH] == 8]]></Expression>
                <Expression name="sep"><![CDATA[[MONTH] == 9]]></Expression>
                <Expression name="oct"><![CDATA[[MONTH] == 10]]></Expression>
                <Expression name="nov"><![CDATA[[MONTH] == 11]]></Expression>
            </Expressions>
            <Compare expression="jan">
                <PartText x="211" y="41" width="239" height="40">
                    <Text align="START"><Font family="SYNC_TO_DEVICE" size="30" weight="BOLD" color="#ffffffff"><Template>JAN %d<Parameter expression="[DAY]" /></Template></Font></Text>
                </PartText>
            </Compare>
            <Compare expression="feb">
                <PartText x="211" y="41" width="239" height="40">
                    <Text align="START"><Font family="SYNC_TO_DEVICE" size="30" weight="BOLD" color="#ffffffff"><Template>FEB %d<Parameter expression="[DAY]" /></Template></Font></Text>
                </PartText>
            </Compare>
            <Compare expression="mar">
                <PartText x="211" y="41" width="239" height="40">
                    <Text align="START"><Font family="SYNC_TO_DEVICE" size="30" weight="BOLD" color="#ffffffff"><Template>MAR %d<Parameter expression="[DAY]" /></Template></Font></Text>
                </PartText>
            </Compare>
            <Compare expression="apr">
                <PartText x="211" y="41" width="239" height="40">
                    <Text align="START"><Font family="SYNC_TO_DEVICE" size="30" weight="BOLD" color="#ffffffff"><Template>APR %d<Parameter expression="[DAY]" /></Template></Font></Text>
                </PartText>
            </Compare>
            <Compare expression="may">
                <PartText x="211" y="41" width="239" height="40">
                    <Text align="START"><Font family="SYNC_TO_DEVICE" size="30" weight="BOLD" color="#ffffffff"><Template>MAY %d<Parameter expression="[DAY]" /></Template></Font></Text>
                </PartText>
            </Compare>
            <Compare expression="jun">
                <PartText x="211" y="41" width="239" height="40">
                    <Text align="START"><Font family="SYNC_TO_DEVICE" size="30" weight="BOLD" color="#ffffffff"><Template>JUN %d<Parameter expression="[DAY]" /></Template></Font></Text>
                </PartText>
            </Compare>
            <Compare expression="jul">
                <PartText x="211" y="41" width="239" height="40">
                    <Text align="START"><Font family="SYNC_TO_DEVICE" size="30" weight="BOLD" color="#ffffffff"><Template>JUL %d<Parameter expression="[DAY]" /></Template></Font></Text>
                </PartText>
            </Compare>
            <Compare expression="aug">
                <PartText x="211" y="41" width="239" height="40">
                    <Text align="START"><Font family="SYNC_TO_DEVICE" size="30" weight="BOLD" color="#ffffffff"><Template>AUG %d<Parameter expression="[DAY]" /></Template></Font></Text>
                </PartText>
            </Compare>
            <Compare expression="sep">
                <PartText x="211" y="41" width="239" height="40">
                    <Text align="START"><Font family="SYNC_TO_DEVICE" size="30" weight="BOLD" color="#ffffffff"><Template>SEP %d<Parameter expression="[DAY]" /></Template></Font></Text>
                </PartText>
            </Compare>
            <Compare expression="oct">
                <PartText x="211" y="41" width="239" height="40">
                    <Text align="START"><Font family="SYNC_TO_DEVICE" size="30" weight="BOLD" color="#ffffffff"><Template>OCT %d<Parameter expression="[DAY]" /></Template></Font></Text>
                </PartText>
            </Compare>
            <Compare expression="nov">
                <PartText x="211" y="41" width="239" height="40">
                    <Text align="START"><Font family="SYNC_TO_DEVICE" size="30" weight="BOLD" color="#ffffffff"><Template>NOV %d<Parameter expression="[DAY]" /></Template></Font></Text>
                </PartText>
            </Compare>
            <Default>
                <PartText x="211" y="41" width="239" height="40">
                    <Text align="START"><Font family="SYNC_TO_DEVICE" size="30" weight="BOLD" color="#ffffffff"><Template>DEC %d<Parameter expression="[DAY]" /></Template></Font></Text>
                </PartText>
            </Default>
        </Condition>

        <!-- ============================================================
             TIME - "10:50"

             12-hour with no leading zero, matching the stock face.
             For 24-hour, change [HOUR_1_12] to [HOUR_0_23].

             Taps anywhere on the face are handled by the TAP LAYER at
             the end of the scene.
             ============================================================ -->
        <PartText x="25" y="105" width="400" height="145" alpha="255">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="134" weight="BOLD" color="#ffa0a7ff">
                    <Template>%d:%02d<Parameter expression="[HOUR_1_12]" /><Parameter expression="[MINUTE]" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- ============================================================
             GLUCOSE - the Dexcom reading, rendered BIG

             The provider is NOT the Dexcom app: on this watch the
             complication comes from "Glucose Watch" (Sagitta Software),
             com.sagittasoftware.glucosewatch, which bridges Dexcom data.
             Verified via adb: it supports SHORT_TEXT, LONG_TEXT,
             RANGED_VALUE, SMALL_IMAGE, MONOCHROMATIC_IMAGE (5 min updates).

             We render SHORT_TEXT first - that is what strips "mmol/L"
             and the "3m" timestamp. The DefaultProviderPolicy pre-wires
             the provider so the face arrives with glucose attached.
             ============================================================ -->
        <ComplicationSlot
            slotId="0"
            x="106" y="255" width="360" height="118"
            displayName="@string/complication_glucose"
            supportedTypes="SHORT_TEXT LONG_TEXT"
            isCustomizable="TRUE"
            alpha="255">

            <DefaultProviderPolicy
                primaryProvider="com.sagittasoftware.glucosewatch/com.sagittasoftware.glucosewatch.wear.GlucoseComplicationService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="SHORT_TEXT" />

            <BoundingBox x="0" y="0" width="360" height="118" />

            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="360" height="118" alpha="255">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="100" weight="BOLD" color="#ffffffff">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="LONG_TEXT">
                <PartText x="-61" y="0" width="360" height="118" alpha="255">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="72" weight="BOLD" color="#ffffffff">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

        </ComplicationSlot>

        <!-- ============================================================
             LAST VOICE LOG - "✓ Logged 2" under the glucose

             Fed by Sugar.AI's watch app (glucose-app wear module,
             LogStatusComplicationService): after she logs by voice the
             logger closes itself in 5 s, so the tick stays here for
             10 minutes. "Held on watch" while entries wait for her
             phone. Nothing at all otherwise (NO_DATA draws nothing).
             Same periwinkle as the clock.
             ============================================================ -->
        <ComplicationSlot
            slotId="1"
            x="75" y="370" width="300" height="42"
            displayName="@string/complication_last_log"
            supportedTypes="SHORT_TEXT"
            isCustomizable="TRUE"
            alpha="255">

            <DefaultProviderPolicy
                primaryProvider="com.geoffchan.glucosewidget/com.geoffchan.glucosewidget.wear.LogStatusComplicationService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="SHORT_TEXT" />

            <BoundingBox x="0" y="0" width="300" height="42" />

            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="300" height="42" alpha="255">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="28" weight="BOLD" color="#ffa0a7ff">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

        </ComplicationSlot>

        <!-- ============================================================
             TAP LAYER - the whole face opens the assistant

             An invisible full-face rectangle, last so it sits on top of
             the time, date and glucose complication: a tap anywhere
             opens Glucose Log (glucose-app wear module) straight into
             the microphone. The complication no longer opens Glucose
             Watch on tap (Geoff, 2026-10-08). Swipes still reach tiles
             and notifications - those are system gestures.
             ============================================================ -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Rectangle x="0" y="0" width="450" height="450">
                <Fill color="#00000000" />
            </Rectangle>
            <Launch target="com.geoffchan.glucosewidget/com.geoffchan.glucosewidget.wear.LogActivity" />
        </PartDraw>

    </Scene>
</WatchFace>
